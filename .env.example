# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y completa los valores antes de ejecutar la aplicación

# Configuración de la base de datos
DB_HOST=localhost
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=chc_rebanado
DB_PORT=3306

# Puerto donde se ejecutará la aplicación
PORT=3001

# Clave para la sesión
SESSION_SECRET=secreto_super_seguro
# Integración CORONELBOT / SAP / Siclik
# Use un token largo, privado y diferente a SESSION_SECRET.
REBANADO_SYNC_TOKEN=cambia_este_token_por_un_valor_seguro

# Alerta visual si CORONELBOT no registra contacto/heartbeat dentro de este número de horas.
REBANADO_SYNC_ALERT_HOURS=6
# Margen para evitar alertas breves por retrasos normales del programador.
REBANADO_SYNC_ALERT_GRACE_MINUTES=30

# Términos configurables para decidir si una línea aplica a rebanado.
REBANADO_PRODUCT_INCLUDE_TERMS=Rebanada,Rebanado,Estándar,Grueso,Corte
REBANADO_PRODUCT_EXCLUDE_TERMS=Barra

# Tamaño máximo del JSON recibido por la API.
REBANADO_SYNC_BODY_LIMIT=2mb
