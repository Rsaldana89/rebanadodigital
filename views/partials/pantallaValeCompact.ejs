<%
  const displayProducts = typeof showProducts === 'undefined' ? true : Boolean(showProducts);
  const isSiclik = Boolean(vale.external_key) || String(vale.origen || '').toLowerCase() === 'siclik';
  const salesOrder = vale.sap_docnum || vale.numero_pedido;
  const showListoTime = Boolean(vale.listo_time) && ['Listo', 'Entregado'].includes(vale.estado);
  const showDeliveredTime = Boolean(vale.entregado_time) && vale.estado === 'Entregado';
%>
<article class="warehouse-compact-card">
  <% if (isSiclik) { %>
    <div class="warehouse-compact-siclik-reference">
      <div>
        <small>Pedido / orden de venta</small>
        <strong><%= salesOrder || 'Sin referencia' %></strong>
      </div>
      <span>Vale <%= vale.folio %></span>
    </div>
  <% } else { %>
    <div class="warehouse-compact-top"><strong><%= vale.folio %></strong><% if (vale.numero_pedido) { %><span>Pedido <%= vale.numero_pedido %></span><% } %></div>
  <% } %>
  <h3><%= vale.cliente %></h3>
  <p class="<%= vale.lugar_entrega ? '' : 'is-missing' %>"><i class="bi bi-geo-alt-fill"></i><%= vale.lugar_entrega || 'Lugar por confirmar' %></p>
  <% if (displayProducts) { %>
    <div class="warehouse-compact-products"><%= (vale.productos || []).slice(0, 2).map(item => `${item.cantidad} · ${item.producto}`).join(' / ') || 'Sin productos' %></div>
  <% } %>
  <% if (showListoTime || showDeliveredTime) { %>
    <div class="warehouse-compact-state-times">
      <% if (showListoTime) { %><span><i class="bi bi-check2-circle"></i>Listo <strong><%= vale.listo_time %></strong></span><% } %>
      <% if (showDeliveredTime) { %><span><i class="bi bi-truck"></i>Entregado <strong><%= vale.entregado_time %></strong></span><% } %>
    </div>
  <% } %>
</article>
