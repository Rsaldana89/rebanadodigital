<%
  const compactSuccessMsg = /^Bienvenido/i.test(success_msg || '') ? null : success_msg;
  const canCreateVale = typeof can === 'function' && can('vales.create');
  const canEditVale = typeof can === 'function' && can('vales.edit');
%>
<%- include('../partials/header', {
  title: 'Vales',
  user: user,
  success_msg: compactSuccessMsg,
  error_msg: error_msg,
  compactAlerts: true,
  bodyClass: 'tablero-dark-body tablero-operator-body tablero-simple-body'
}) %>

<%
  const estadoInfo = {
    Todos: { cls: 'all', icon: 'bi-grid-1x2' },
    Pendiente: { cls: 'pending', icon: 'bi-hourglass-split', accion: 'Iniciar rebanado', siguiente: 'Rebanando', btnIcon: 'bi-play-circle-fill' },
    Rebanando: { cls: 'working', icon: 'bi-gear-wide-connected', accion: 'Marcar como listo', siguiente: 'Listo', btnIcon: 'bi-check2-circle' },
    Listo: { cls: 'ready', icon: 'bi-check2-circle', accion: 'Entregar vale', siguiente: 'Entregado', btnIcon: 'bi-truck' },
    Entregado: { cls: 'delivered', icon: 'bi-truck' },
    Cancelado: { cls: 'cancelled', icon: 'bi-x-circle' }
  };
  const prioridadInfo = {
    Alta: { cls: 'high', icon: 'bi-exclamation-circle-fill' },
    Normal: { cls: 'normal', icon: 'bi-flag-fill' },
    Baja: { cls: 'low', icon: 'bi-arrow-down-circle-fill' }
  };
  const estadosOrden = ['Pendiente','Rebanando','Listo','Entregado','Cancelado'];
  const allVales = estadosOrden.flatMap(est => (estados[est] || []));
  const activos = (estados.Pendiente.length || 0) + (estados.Rebanando.length || 0) + (estados.Listo.length || 0);
  const returnUrl = `/vales/tablero?fecha=${encodeURIComponent(filtroFecha)}`;
%>

<section class="operator-commandbar" aria-labelledby="operatorBoardTitle">
  <div class="operator-command-main">
    <div class="operator-kicker">Centro operativo de rebanado</div>
    <div class="operator-title-line">
      <h1 id="operatorBoardTitle">Gestión de vales</h1>
      <span class="operator-total"><strong><%= activos %></strong> activos</span>
      <% if (overdueCount > 0) { %>
        <span class="operator-overdue"><i class="bi bi-exclamation-triangle-fill"></i><strong><%= overdueCount %></strong> atrasado<%= overdueCount === 1 ? '' : 's' %></span>
      <% } %>
    </div>
    <div class="operator-date-line">
      <i class="bi bi-calendar3"></i><span>Entrega visible: <strong><%= filtroFechaDisplay %></strong></span>
      <span class="operator-date-separator">·</span>
      <i class="bi bi-clock"></i><span><%= horaActual %></span>
    </div>
  </div>

  <div class="operator-command-actions">
    <% if (canCreateVale) { %>
      <a href="/vales/crear" class="operator-screen-link operator-new-link" title="Crear una nueva comanda">
        <i class="bi bi-plus-lg"></i><span>Nuevo vale</span>
      </a>
    <% } %>
    <a href="/pantalla?fecha=<%= filtroFecha %>" target="_blank" class="operator-screen-link" title="Abrir pantalla de almacén">
      <i class="bi bi-display"></i><span>Pantalla</span>
    </a>
  </div>
</section>

<% if (syncStatus) {
  const syncHealthy = syncStatus.ok && !syncStatus.stale;
  const syncLastContact = syncStatus.lastContactAt
    ? new Date(syncStatus.lastContactAt).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', dateStyle: 'short', timeStyle: 'short' })
    : 'Sin contacto de CORONELBOT';
  const syncSummary = syncStatus.lastSummary || { created: 0, updated: 0, skipped: 0 };
%>
  <section class="operator-sync-strip <%= syncHealthy ? 'is-healthy' : 'is-alert' %>" aria-label="Estado de sincronización SAP y Siclik">
    <i class="bi <%= syncHealthy ? 'bi-cloud-check-fill' : 'bi-cloud-exclamation-fill' %>"></i>
    <div><strong>CORONELBOT: <%= syncHealthy ? 'OK' : 'ALERTA' %></strong><span>Último contacto: <%= syncLastContact %></span></div>
    <div class="operator-sync-summary"><%= syncSummary.created %> creados · <%= syncSummary.updated %> actualizados · <%= syncSummary.skipped %> omitidos</div>
    <% if (syncStatus.lastError) { %><div class="operator-sync-error" title="<%= syncStatus.lastError %>"><%= String(syncStatus.lastError).split('\n')[0] %></div><% } %>
  </section>
<% } %>

<section class="operator-tools" aria-label="Filtros del tablero">
  <div class="operator-tools-top">
    <form method="get" action="/vales/tablero" class="operator-date-form">
      <label for="fecha" class="visually-hidden">Fecha de entrega</label>
      <span class="operator-control-label"><i class="bi bi-calendar-event"></i>Entrega</span>
      <input type="date" id="fecha" name="fecha" value="<%= filtroFecha %>" class="form-control">
      <button type="submit" class="operator-icon-button" title="Aplicar fecha" aria-label="Aplicar fecha"><i class="bi bi-arrow-right"></i></button>
      <a href="/vales/tablero" class="operator-today-link">Hoy</a>
    </form>

    <div class="ops-search operator-search">
      <i class="bi bi-search"></i>
      <input type="search" id="opsSearch" placeholder="Buscar vale, pedido, cliente, artículo o SKU" aria-label="Buscar vales">
      <button type="button" id="opsSearchClear" class="operator-search-clear d-none" title="Limpiar búsqueda" aria-label="Limpiar búsqueda"><i class="bi bi-x-lg"></i></button>
    </div>
  </div>

  <div class="operator-filter-row" role="group" aria-label="Filtrar vales por estado">
    <button class="operator-filter-pill is-all active" type="button" data-filter-status="Todos" aria-pressed="true">
      <span>Todos</span><strong><%= allVales.length %></strong>
    </button>
    <% estadosOrden.forEach(function(est){ const info = estadoInfo[est]; %>
      <button id="<%= est %>" class="operator-filter-pill is-<%= info.cls %>" type="button" data-filter-status="<%= est %>" aria-pressed="false">
        <i class="bi <%= info.icon %>"></i><span><%= est %></span><strong><%= estados[est].length %></strong>
      </button>
    <% }) %>
    <span class="operator-visible-count"><strong id="visibleOpsCount"><%= allVales.length %></strong> visibles · <span id="currentFilterLabel">Todos</span></span>
  </div>
</section>

<section class="ops-list simple-vale-grid" id="opsList" aria-live="polite">
  <% if (!allVales.length) { %>
    <div class="empty-state empty-state-card">
      <i class="bi bi-inbox"></i>
      <div>No hay vales programados ni atrasados visibles para <strong><%= filtroFechaDisplay %></strong>.</div>
    </div>
  <% } %>

  <% allVales.forEach(function(vale){
    const e = estadoInfo[vale.estado] || estadoInfo.Pendiente;
    const p = prioridadInfo[vale.prioridad] || prioridadInfo.Normal;
    const entregaDisplay = vale.entrega_display || '';
    const atrasoTexto = vale.days_late === 1 ? '1 día tarde' : `${vale.days_late} días tarde`;
    const searchText = `${vale.folio} ${vale.numero_pedido || ''} ${vale.cliente} ${vale.productos_busqueda || ''} ${vale.prioridad} ${vale.estado} ${entregaDisplay} ${vale.is_overdue ? 'atrasado retraso' : ''}`.toLowerCase();
    const allowedStates = vale.allowed_states || [];
    const canAdvance = e.siguiente ? allowedStates.includes(e.siguiente) : false;
    const canCancel = !['Entregado','Cancelado'].includes(vale.estado) && allowedStates.includes('Cancelado');
    const showMoreMenu = canCancel || canEditVale;
    const cardReturnUrl = `${returnUrl}&focus=${vale.id}#vale-${vale.id}`;
  %>
    <article
      id="vale-<%= vale.id %>"
      class="simple-vale-card op-vale-<%= e.cls %> <%= vale.is_overdue ? 'op-vale-overdue' : '' %>"
      data-vale-id="<%= vale.id %>"
      data-status="<%= vale.estado %>"
      data-search="<%= searchText %>"
      tabindex="-1">

      <header class="simple-vale-header">
        <div class="simple-vale-identity">
          <span class="simple-overline">Número de vale</span>
          <strong class="simple-vale-folio"><%= vale.folio %></strong>
          <div class="simple-order-line">
            <span>Pedido / orden:</span>
            <strong><%= vale.numero_pedido || 'Sin referencia' %></strong>
          </div>
        </div>

        <div class="simple-status-area">
          <span class="simple-status-badge"><i class="bi <%= e.icon %>"></i><%= vale.estado %></span>
          <div class="simple-secondary-badges">
            <span class="operator-priority priority-<%= p.cls %>"><i class="bi <%= p.icon %>"></i><%= vale.prioridad %></span>
            <% if (vale.is_overdue) { %>
              <span class="operator-late"><i class="bi bi-exclamation-triangle-fill"></i><%= atrasoTexto %></span>
            <% } %>
          </div>
        </div>
      </header>

      <section class="simple-client-block">
        <div class="simple-client-main">
          <span class="simple-overline">Cliente / sucursal</span>
          <strong class="simple-client-name"><%= vale.cliente %></strong>
        </div>
        <div class="simple-client-side">
          <span class="simple-client-chip">
            <i class="bi bi-calendar2-check"></i>
            <span>
              <small>Entrega</small>
              <strong><%= entregaDisplay %></strong>
            </span>
          </span>
          <span class="simple-client-chip">
            <i class="bi <%= vale.external_key ? 'bi-cloud-arrow-down-fill' : 'bi-pencil-square' %>"></i>
            <span>
              <small>Origen</small>
              <strong><%= vale.external_key ? 'CORONELBOT / Siclik' : (vale.origen || 'Manual') %></strong>
            </span>
          </span>
        </div>
      </section>

      <section class="simple-products-section" aria-label="Artículos del vale">
        <div class="simple-products-title">
          <span><i class="bi bi-list-check"></i>Artículos a rebanar</span>
          <strong><%= vale.total_productos || 0 %></strong>
        </div>

        <div class="simple-product-list">
          <% (vale.productos || []).forEach(function(item, productIndex){
               const presentacionTexto = String(item.presentacion || '').trim();
               const corteTexto = String(item.tipo_rebanado || '').trim();
               const mostrarPresentacion = presentacionTexto && presentacionTexto.toLocaleLowerCase('es-MX') !== corteTexto.toLocaleLowerCase('es-MX');
          %>
            <div class="simple-product-row">
              <div class="simple-product-left">
                <div class="simple-product-number"><%= productIndex + 1 %></div>
                <div class="simple-product-quantity">
                  <strong><%= item.cantidad %></strong>
                  <% if (mostrarPresentacion) { %>
                    <span><%= presentacionTexto %></span>
                  <% } %>
                </div>
              </div>
              <div class="simple-product-description">
                <strong><%= item.producto %></strong>
                <span>SKU <%= item.sku %></span>
                <% if (item.observaciones) { %>
                  <small><i class="bi bi-chat-left-text"></i><%= item.observaciones %></small>
                <% } %>
              </div>
              <% if (corteTexto) { %>
                <div class="simple-product-cut"><%= corteTexto %></div>
              <% } else { %>
                <div class="simple-product-cut is-empty">Sin corte indicado</div>
              <% } %>
            </div>
          <% }) %>
          <% if (!(vale.productos || []).length) { %>
            <div class="simple-product-empty"><i class="bi bi-exclamation-triangle"></i>Sin productos registrados</div>
          <% } %>
        </div>
      </section>

      <% if (vale.entrega_es_rango) { %>
        <div class="simple-range-note"><i class="bi bi-info-circle"></i>Entrega con rango indicado por Siclik.</div>
      <% } %>

      <% if (vale.observaciones) { %>
        <div class="simple-vale-note"><i class="bi bi-chat-left-text-fill"></i><span><%= vale.observaciones %></span></div>
      <% } %>

      <footer class="simple-vale-actions">
        <div class="simple-main-actions">
          <% if (e.siguiente && canAdvance) { %>
            <form method="post" action="/vales/<%= vale.id %>/estado" class="operator-primary-form operator-state-form" data-focus-id="<%= vale.id %>">
              <input type="hidden" name="return_url" value="<%= cardReturnUrl %>">
              <input type="hidden" name="nuevo_estado" value="<%= e.siguiente %>">
              <button type="submit" class="simple-primary-action state-<%= e.cls %>">
                <i class="bi <%= e.btnIcon %>"></i><span><%= e.accion %></span>
              </button>
            </form>
          <% } else if (vale.estado === 'Listo') { %>
            <div class="simple-state-message is-ready"><i class="bi bi-check2-circle"></i><span>Listo para entregar</span></div>
          <% } else if (e.siguiente) { %>
            <div class="simple-state-message"><i class="bi bi-lock-fill"></i><span>Acción restringida</span></div>
          <% } else { %>
            <div class="simple-state-message"><i class="bi <%= e.icon %>"></i><span><%= vale.estado %></span></div>
          <% } %>

          <a href="/vales/<%= vale.id %>?return_url=<%= encodeURIComponent(cardReturnUrl) %>" class="simple-detail-action" data-board-return-link data-focus-id="<%= vale.id %>">
            <i class="bi bi-eye-fill"></i><span>Ver detalle</span>
          </a>
        </div>

        <% if (showMoreMenu) { %>
          <details class="operator-more-menu simple-more-menu">
            <summary title="Más acciones" aria-label="Más acciones"><i class="bi bi-three-dots-vertical"></i></summary>
            <div class="operator-more-panel command-more-panel">
              <% if (canEditVale) { %>
                <a href="/vales/<%= vale.id %>/editar?return_url=<%= encodeURIComponent(cardReturnUrl) %>" data-board-return-link data-focus-id="<%= vale.id %>"><i class="bi bi-pencil-square"></i>Editar comanda</a>
              <% } %>
              <% if (canCancel) { %>
                <form method="post" action="/vales/<%= vale.id %>/estado" class="operator-state-form" data-focus-id="<%= vale.id %>" data-confirm="¿Cancelar este vale completo?">
                  <input type="hidden" name="return_url" value="<%= cardReturnUrl %>">
                  <input type="hidden" name="nuevo_estado" value="Cancelado">
                  <button type="submit"><i class="bi bi-x-circle"></i>Cancelar vale</button>
                </form>
              <% } %>
            </div>
          </details>
        <% } else { %>
          <span class="simple-more-placeholder" aria-hidden="true"></span>
        <% } %>
      </footer>
    </article>
  <% }) %>

  <div id="opsEmptyFilter" class="empty-state empty-state-card d-none">
    <i class="bi bi-search"></i>
    <div>No hay vales que coincidan con el filtro.</div>
  </div>
</section>

<%- include('../partials/footer') %>
