<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pantalla informativa | CHC Rebanado Digital</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/institutional.css">
</head>
<body class="tv-body tv-warehouse-body">
  <%
    const counts = {
      Pendiente: (estados.Pendiente || []).length,
      Rebanando: (estados.Rebanando || []).length,
      Listo: (estados.Listo || []).length,
      Entregado: (estados.Entregado || []).length,
      Cancelado: (estados.Cancelado || []).length
    };
    const activeSections = [
      { name: 'Listo', title: 'Listos para entregar', icon: 'bi-check2-circle', note: 'Prioridad inmediata para almacén' },
      { name: 'Rebanando', title: 'En rebanado', icon: 'bi-gear-wide-connected', note: 'Pedidos que se están preparando' },
      { name: 'Pendiente', title: 'Pendientes', icon: 'bi-hourglass-split', note: 'Pedidos en espera de iniciar' }
    ];
  %>

  <main class="warehouse-screen">
    <header class="warehouse-header">
      <div class="warehouse-brand">
        <span class="brand-monogram brand-monogram-lg">CHC</span>
        <div>
          <div class="warehouse-kicker">Pantalla informativa de almacén</div>
          <h1>Rebanado Digital</h1>
          <p>Entrega <strong><%= filtroFechaDisplay %></strong><% if (overdueCount > 0) { %> · <strong><%= overdueCount %></strong> vale(s) activo(s) atrasado(s)<% } %></p>
        </div>
      </div>
      <div class="warehouse-clock">
        <i class="bi bi-clock-fill"></i>
        <div><strong><%= horaActual %></strong><span>Actualización automática cada 30 s</span></div>
      </div>
    </header>

    <section class="warehouse-status-strip" aria-label="Resumen por estado">
      <div class="warehouse-status-pill is-ready"><i class="bi bi-check2-circle"></i><span>Listos</span><strong><%= counts.Listo %></strong></div>
      <div class="warehouse-status-pill is-working"><i class="bi bi-gear-wide-connected"></i><span>Rebanando</span><strong><%= counts.Rebanando %></strong></div>
      <div class="warehouse-status-pill is-pending"><i class="bi bi-hourglass-split"></i><span>Pendientes</span><strong><%= counts.Pendiente %></strong></div>
      <div class="warehouse-status-pill is-delivered"><i class="bi bi-truck"></i><span>Entregados</span><strong><%= counts.Entregado %></strong></div>
      <div class="warehouse-status-pill is-cancelled"><i class="bi bi-x-circle"></i><span>Cancelados</span><strong><%= counts.Cancelado %></strong></div>
    </section>

    <% if (overdueCount > 0) { %>
      <div class="warehouse-overdue-alert"><i class="bi bi-exclamation-triangle-fill"></i><span><strong><%= overdueCount %> vale(s)</strong> siguen activos después de su fecha de entrega.</span></div>
    <% } %>

    <div class="warehouse-layout">
      <section class="warehouse-active-column" aria-label="Vales activos">
        <% activeSections.forEach(section => { const sectionVales = estados[section.name] || []; %>
          <section class="warehouse-state-section is-<%= section.name.toLowerCase() %>">
            <header class="warehouse-section-header">
              <div class="warehouse-section-title"><i class="bi <%= section.icon %>"></i><div><h2><%= section.title %></h2><p><%= section.note %></p></div></div>
              <strong class="warehouse-section-count"><%= sectionVales.length %></strong>
            </header>
            <% if (sectionVales.length) { %>
              <div class="warehouse-card-grid">
                <% sectionVales.forEach(vale => { %>
                  <%- include('partials/pantallaValeCard', { vale }) %>
                <% }) %>
              </div>
            <% } else { %>
              <div class="warehouse-section-empty"><i class="bi bi-check-circle"></i>Sin vales en este estado</div>
            <% } %>
          </section>
        <% }) %>
      </section>

      <aside class="warehouse-history-column" aria-label="Seguimiento rápido por estado">
        <header class="warehouse-history-header">
          <div><span>Seguimiento rápido</span><strong>Estados importantes</strong></div>
          <i class="bi bi-arrow-down-up" title="Desplazamiento automático"></i>
        </header>

        <section class="warehouse-side-panel is-priority" aria-label="Listos y rebanando">
          <header class="warehouse-side-panel-heading">
            <span>Listos y rebanando</span>
            <small>Folio, cliente y entrega</small>
          </header>
          <div class="warehouse-history-scroll" data-auto-scroll data-scroll-key="important">
            <section class="warehouse-history-section is-ready">
              <div class="warehouse-history-title"><span><i class="bi bi-check2-circle"></i>Listos</span><strong><%= counts.Listo %></strong></div>
              <% if ((estados.Listo || []).length) { %>
                <div class="warehouse-history-list">
                  <% estados.Listo.forEach(vale => { %>
                    <%- include('partials/pantallaValeCompact', { vale, showProducts: false }) %>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="warehouse-history-empty">No hay vales listos.</div>
              <% } %>
            </section>

            <section class="warehouse-history-section is-working">
              <div class="warehouse-history-title"><span><i class="bi bi-gear-wide-connected"></i>Rebanando</span><strong><%= counts.Rebanando %></strong></div>
              <% if ((estados.Rebanando || []).length) { %>
                <div class="warehouse-history-list">
                  <% estados.Rebanando.forEach(vale => { %>
                    <%- include('partials/pantallaValeCompact', { vale, showProducts: false }) %>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="warehouse-history-empty">No hay vales rebanando.</div>
              <% } %>
            </section>
          </div>
        </section>

        <section class="warehouse-side-panel is-activity" aria-label="Entregados y cancelados">
          <header class="warehouse-side-panel-heading">
            <span>Actividad del día</span>
            <small>Entregados y cancelados</small>
          </header>
          <div class="warehouse-history-scroll warehouse-history-scroll-secondary" data-auto-scroll data-scroll-key="activity">
            <section class="warehouse-history-section is-delivered">
              <div class="warehouse-history-title"><span><i class="bi bi-truck"></i>Entregados</span><strong><%= counts.Entregado %></strong></div>
              <% if ((estados.Entregado || []).length) { %>
                <div class="warehouse-history-list">
                  <% estados.Entregado.forEach(vale => { %>
                    <%- include('partials/pantallaValeCompact', { vale }) %>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="warehouse-history-empty">Aún no hay entregados.</div>
              <% } %>
            </section>

            <section class="warehouse-history-section is-cancelled">
              <div class="warehouse-history-title"><span><i class="bi bi-x-circle"></i>Cancelados</span><strong><%= counts.Cancelado %></strong></div>
              <% if ((estados.Cancelado || []).length) { %>
                <div class="warehouse-history-list">
                  <% estados.Cancelado.forEach(vale => { %>
                    <%- include('partials/pantallaValeCompact', { vale }) %>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="warehouse-history-empty">No hay cancelados.</div>
              <% } %>
            </section>
          </div>
        </section>
      </aside>
    </div>
  </main>

  <script>
    (() => {
      const storagePrefix = 'chc-pantalla-scroll-';

      document.querySelectorAll('[data-auto-scroll]').forEach(scroller => {
        const key = storagePrefix + (scroller.dataset.scrollKey || 'general');
        let direction = Number(window.sessionStorage.getItem(`${key}-direction`)) || 1;
        let pauseUntil = Date.now() + 1200;
        const savedPosition = Number(window.sessionStorage.getItem(`${key}-position`));

        if (Number.isFinite(savedPosition)) {
          scroller.scrollTop = Math.min(savedPosition, Math.max(0, scroller.scrollHeight - scroller.clientHeight));
        }

        window.setInterval(() => {
          if (scroller.scrollHeight <= scroller.clientHeight || Date.now() < pauseUntil) return;

          const atBottom = scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 2;
          const atTop = scroller.scrollTop <= 0;

          if (atBottom && direction > 0) {
            direction = -1;
            pauseUntil = Date.now() + 1400;
          } else if (atTop && direction < 0) {
            direction = 1;
            pauseUntil = Date.now() + 1400;
          } else {
            scroller.scrollTop += direction;
          }

          window.sessionStorage.setItem(`${key}-position`, String(scroller.scrollTop));
          window.sessionStorage.setItem(`${key}-direction`, String(direction));
        }, 40);
      });

      window.setTimeout(() => window.location.reload(), 30000);
    })();
  </script>
</body>
</html>
